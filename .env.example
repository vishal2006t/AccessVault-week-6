# DG Interns Hub - Week 6: Authentication System Environment Variables
# Copy this file to .env and adjust values if needed

# Server Port
PORT=5000

# MongoDB Connection String (Points to Docker container port 27017)
MONGODB_URI=mongodb://localhost:27017/week6_auth

# JSON Web Token (JWT) Secret Key - Used to sign and verify tokens
JWT_SECRET=dg_interns_hub_week6_super_secure_jwt_secret_key_2026

# JWT Expiration Time (e.g. 1d, 24h, 7d)
JWT_EXPIRES_IN=1d

# Node Environment
NODE_ENV=development
